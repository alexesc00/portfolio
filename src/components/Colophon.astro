---
const repositoryUrl = 'https://github.com/alexesc00/portfolio';
---

{/* One line on wide screens; on phones each clause breaks onto its own line. */}
<p class="text-right text-text-muted">
  <span class="block md:inline">Designed in Figma,</span>{' '}
  <span class="block md:inline">
    built in the open on{' '}
    <a
      href={repositoryUrl}
      class="text-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-text"
    >
      <span class="underline">GitHub</span> <span aria-hidden="true">↗</span>
    </a>
    ,
  </span>{' '}
  <span class="block md:inline">
    shown in{' '}
    <span class="text-text">
      <span class="light:hidden">dark</span>
      <span class="hidden light:inline">light</span>
    </span>
  </span>
</p>
