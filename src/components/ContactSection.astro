---
const linkedInUrl = 'https://www.linkedin.com/in/alexesc1111/';
---

{/*
 * The last screen: the contact at the top left and a way back up at the
 * bottom right. At least one screen tall, so the page always ends on a
 * whole screen. It isn't a footer: the name, colophon and theme switch
 * stay in the hero.
 */}
<section
  id="contact"
  aria-labelledby="contact-heading"
  class="mx-auto flex min-h-plate w-full max-w-(--breakpoint-2xl) flex-col px-page pt-inset pb-inset"
>
  {/* Like every section, it opens on its name at the top left. */}
  <h2 id="contact-heading" class="mb-12 text-display md:mb-16">
    Contact
  </h2>
  <div>
    {/* On phones the address breaks after the @, not wherever it runs out. */}
    <a href="mailto:hello@alexescudero.design" class="text-lead">
      <span class="max-md:block">hello@</span>alexescudero.design
    </a>
    <p class="mt-4">
      <a href={linkedInUrl} class="text-text-muted hover:text-text">
        LinkedIn <span aria-hidden="true">↗</span>
      </a>
    </p>
  </div>
  <a href="#top" class="mt-auto self-end">
    <span aria-hidden="true">↑</span> <span class="sr-only">Back to </span>Top
  </a>
</section>
