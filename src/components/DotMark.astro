{/*
 * The Æ drawn as dots, filling the hero behind its text. A still made in
 * CSS shows first, and is all that visitors with reduced motion or without
 * JavaScript see. The canvas takes over once it has drawn the same dots in
 * the same places, so the swap can't be seen.
 */}
<div
  class="group pointer-events-none absolute inset-0 -z-10 overflow-hidden"
  aria-hidden="true"
  data-dot-mark
>
  <canvas class="invisible absolute inset-0 size-full group-data-drawn:visible"></canvas>
  <span
    class="still absolute top-1/2 left-1/2 -translate-1/2 text-mark text-foreground select-none group-data-drawn:invisible"
    data-still
  >
    Æ
  </span>
</div>

<style>
  .still {
    /* The Æ sits a little left of its box; this centers the letter itself. */
    margin-left: 0.014em;
    /* Soft edges half a pixel either side, like the canvas's dots. */
    background-image: radial-gradient(
      circle,
      currentColor calc(var(--spacing-dot-size) / 2 - 0.5px),
      transparent calc(var(--spacing-dot-size) / 2 + 0.5px)
    );
    background-size: var(--spacing-dot) var(--spacing-dot);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
</style>

<script>
  import { millisecondsOf } from '../lib/css-duration';
  import {
    createTrails,
    heatColorCount,
    heatColorIndex,
    heatColors,
    heatStops,
    isGlowing,
    isStreak,
    smearColorCount,
    smearColorIndex,
    smearColors,
    sortByColor,
    stepTrails,
    streakTail,
    type Trails,
  } from '../lib/dot-colors';
  import {
    canStopDrawing,
    canvasScale,
    choosePusher,
    isNearMark,
    pushRadiusFor,
    sampleDots,
    stepDots,
    type Box,
    type Dots,
    type Point,
  } from '../lib/dot-mark';
  import { parseTheme, type Theme } from '../lib/theme';

  const letter = 'Æ';
  /** How far a glow reaches, in dot radii. */
  const glowReach = 3.2;
  /** A glow's opacity at its middle, where it's brightest. */
  const glowStrength = 0.35;
  const smearWheelSize = 6;
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

  function token(name: string): string {
    return getComputedStyle(document.documentElement)
      .getPropertyValue(name)
      .trim();
  }

  /** A length token, like `--spacing-dot`, in pixels. */
  function tokenInPixels(name: string): number {
    return parseFloat(token(name));
  }

  /** A duration token, like `--transition-duration-afterglow-heat`, in ms. */
  function tokenInMilliseconds(name: string): number {
    return millisecondsOf(token(name));
  }

  /** The theme showing now. The head script always sets one. */
  function currentTheme(): Theme {
    return parseTheme(document.documentElement.dataset.theme) ?? 'dark';
  }

  /**
   * A soft round glow in `color`, drawn once so each frame only has to
   * copy it: blending a new gradient for every dot every frame is slow.
   */
  function makeGlow(color: string, radius: number, scale: number) {
    const size = Math.ceil(radius * 2 * scale);
    const glow = document.createElement('canvas');
    glow.width = size;
    glow.height = size;
    const context = glow.getContext('2d');
    if (!context) return glow;
    const middle = size / 2;
    const gradient = context.createRadialGradient(
      middle,
      middle,
      0,
      middle,
      middle,
      middle,
    );
    context.globalAlpha = glowStrength;
    // Fading to `transparent` would pass through black, as that's
    // transparent black; the same color at no opacity fades cleanly.
    gradient.addColorStop(0, color);
    gradient.addColorStop(1, `${color}00`);
    context.fillStyle = gradient;
    context.fillRect(0, 0, size, size);
    return glow;
  }

  /**
   * Draws the letter off screen exactly where CSS draws the still, and
   * returns its shape and the box around the letter itself.
   */
  function traceLetter(still: HTMLElement, box: Box) {
    const style = getComputedStyle(still);
    const scratch = document.createElement('canvas');
    scratch.width = Math.ceil(box.width);
    scratch.height = Math.ceil(box.height);
    const context = scratch.getContext('2d', { willReadFrequently: true });
    if (!context) return null;

    context.font = `${style.fontWeight} ${style.fontSize} ${style.fontFamily}`;
    const metrics = context.measureText(letter);
    // CSS centers the font's full height in the line, which is as tall as
    // the still's box, and sets the letter on the baseline inside it.
    const baseline =
      (box.height -
        metrics.fontBoundingBoxAscent -
        metrics.fontBoundingBoxDescent) /
        2 +
      metrics.fontBoundingBoxAscent;
    context.fillText(letter, 0, baseline);
    const { data } = context.getImageData(0, 0, scratch.width, scratch.height);

    return {
      isInside(x: number, y: number) {
        const column = Math.floor(x - box.x);
        const row = Math.floor(y - box.y);
        if (column < 0 || row < 0 || column >= scratch.width) return false;
        if (row >= scratch.height) return false;
        return data[(row * scratch.width + column) * 4 + 3] > 127;
      },
      bounds: {
        x: box.x - metrics.actualBoundingBoxLeft,
        y: box.y + baseline - metrics.actualBoundingBoxAscent,
        width: metrics.actualBoundingBoxLeft + metrics.actualBoundingBoxRight,
        height:
          metrics.actualBoundingBoxAscent + metrics.actualBoundingBoxDescent,
      },
    };
  }

  function animate(
    root: HTMLElement,
    canvas: HTMLCanvasElement,
    still: HTMLElement,
    context: CanvasRenderingContext2D,
  ) {
    let dots: Dots | null = null;
    let letterBounds: Box = { x: 0, y: 0, width: 0, height: 0 };
    let pushRadius = 0;
    let dotRadius = 0;
    let scale = 1;
    let theme: Theme = 'dark';
    let trails: Trails = createTrails(0);
    // Each dot's step in the current palette's table, and the dots in
    // order of it, so each color is drawn as one path.
    let colors = new Uint16Array(0);
    let order = new Uint32Array(0);
    // Which dots Smear draws as streaks rather than dots, 1 or 0.
    let streaks = new Uint8Array(0);
    // Made once and reused, so drawing a frame leaves nothing to collect.
    const heatStarts = new Uint32Array(heatColorCount + 1);
    const smearStarts = new Uint32Array(smearColorCount + 1);
    const tail = { x: 0, y: 0 };
    let heatTable: string[] = [];
    let smearTable: string[] = [];
    let glows = new Map<number, HTMLCanvasElement>();
    const afterglow = {
      heat: tokenInMilliseconds('--transition-duration-afterglow-heat'),
      smear: tokenInMilliseconds('--transition-duration-afterglow-smear'),
    };
    let pointer: Point | null = null;
    // Counted from the start, so the mark rests a moment before wandering.
    let pointerGoneAt = performance.now();
    let isOnScreen = false;
    let frameRequest = 0;
    let lastFrame = 0;
    let buildCount = 0;

    async function build() {
      const build = ++buildCount;
      const style = getComputedStyle(still);
      // The fallbacks in the font list name system fonts a visitor may not
      // have, which fails the load even when the site's font arrives, so
      // wait for every font to settle instead.
      await document.fonts
        .load(
          `${style.fontWeight} ${style.fontSize} ${style.fontFamily}`,
          letter,
        )
        .catch(() => undefined);
      await document.fonts.ready;
      // A newer build started while the font loaded; let that one finish.
      if (build !== buildCount || reducedMotion.matches) return;

      const area = root.getBoundingClientRect();
      const letterBox = still.getBoundingClientRect();
      const box = {
        x: letterBox.left - area.left,
        y: letterBox.top - area.top,
        width: letterBox.width,
        height: letterBox.height,
      };
      const shape = traceLetter(still, box);
      if (!shape) return;

      scale = canvasScale(devicePixelRatio);
      canvas.width = Math.round(area.width * scale);
      canvas.height = Math.round(area.height * scale);
      dotRadius = tokenInPixels('--spacing-dot-size') / 2;
      dots = sampleDots({
        box,
        spacing: tokenInPixels('--spacing-dot'),
        isInside: shape.isInside,
      });
      letterBounds = shape.bounds;
      pushRadius = pushRadiusFor(letterBounds.height);
      trails = createTrails(dots.x.length);
      colors = new Uint16Array(dots.x.length);
      order = new Uint32Array(dots.x.length);
      streaks = new Uint8Array(dots.x.length);
      recolor();

      draw();
      root.dataset.drawn = '';
      wake();
    }

    /**
     * Mixes the palette for the theme showing into its table. Mixing
     * throws if a token can't be read, so nothing changes until it has
     * worked: a first build leaves the CSS still showing, and a theme
     * switch keeps the colors it had.
     */
    function recolor() {
      const nextTheme = currentTheme();
      const foreground = token('--color-foreground');
      if (nextTheme === 'dark') {
        const ramp = heatStops.map((at, i) => ({
          at,
          color: token(`--color-heat-${i + 1}`),
        }));
        heatTable = heatColors(ramp, foreground);
      } else {
        const wheel = Array.from({ length: smearWheelSize }, (_, i) =>
          token(`--color-smear-${i + 1}`),
        );
        smearTable = smearColors(wheel, foreground);
      }
      theme = nextTheme;
      glows = new Map();
    }

    function draw() {
      if (!dots) return;
      context.setTransform(scale, 0, 0, scale, 0, 0);
      context.clearRect(0, 0, canvas.width / scale, canvas.height / scale);
      if (theme === 'dark') drawHeat(dots);
      else drawSmear(dots);
    }

    function drawHeat(dots: Dots) {
      const { x, y } = dots;
      const { heat } = trails;
      for (let i = 0; i < x.length; i++) colors[i] = heatColorIndex(heat[i]);
      sortByColor(colors, order, heatStarts);

      // Glows first, added as light, so overlapping ones brighten.
      const glowRadius = dotRadius * glowReach;
      context.globalCompositeOperation = 'lighter';
      for (let i = 0; i < x.length; i++) {
        if (!isGlowing(heat[i])) continue;
        context.drawImage(
          glowFor(colors[i], glowRadius),
          x[i] - glowRadius,
          y[i] - glowRadius,
          glowRadius * 2,
          glowRadius * 2,
        );
      }
      context.globalCompositeOperation = 'source-over';

      forEachColor((color, start, end) => {
        fillDots(dots, heatTable[color], start, end);
      });
    }

    function drawSmear(dots: Dots) {
      const { vx, vy } = trails;
      let hasStreaks = false;
      for (let i = 0; i < dots.x.length; i++) {
        colors[i] = smearColorIndex(vx[i], vy[i]);
        streaks[i] = isStreak(vx[i], vy[i]) ? 1 : 0;
        hasStreaks ||= streaks[i] === 1;
      }
      sortByColor(colors, order, smearStarts);

      // Dots with tails too short to see are drawn as dots, which is far
      // cheaper than lines.
      forEachColor((color, start, end) => {
        fillDots(dots, smearTable[color], start, end, streaks);
        if (hasStreaks) strokeStreaks(dots, smearTable[color], start, end);
      });
    }

    /** Calls `drawGroup` for each run of dots in `order` of one color. */
    function forEachColor(
      drawGroup: (color: number, start: number, end: number) => void,
    ) {
      let start = 0;
      while (start < order.length) {
        const color = colors[order[start]];
        let end = start + 1;
        while (end < order.length && colors[order[end]] === color) end++;
        drawGroup(color, start, end);
        start = end;
      }
    }

    /**
     * Fills the dots from `start` to `end` in `order` as one path, leaving
     * out any marked in `skip`: a single fill is far cheaper than one for
     * each dot.
     */
    function fillDots(
      { x, y }: Dots,
      style: string,
      start: number,
      end: number,
      skip?: Uint8Array,
    ) {
      context.fillStyle = style;
      context.beginPath();
      for (let n = start; n < end; n++) {
        const i = order[n];
        if (skip?.[i]) continue;
        context.moveTo(x[i] + dotRadius, y[i]);
        context.arc(x[i], y[i], dotRadius, 0, Math.PI * 2);
      }
      context.fill();
    }

    /** Draws the streaks among the dots from `start` to `end` in `order`. */
    function strokeStreaks(
      { x, y }: Dots,
      style: string,
      start: number,
      end: number,
    ) {
      const { vx, vy } = trails;
      // A round-capped line as wide as a dot, from its tail to the dot.
      context.lineCap = 'round';
      context.lineWidth = dotRadius * 2;
      context.strokeStyle = style;
      context.beginPath();
      for (let n = start; n < end; n++) {
        const i = order[n];
        if (!streaks[i]) continue;
        streakTail(vx[i], vy[i], tail);
        context.moveTo(x[i] + tail.x, y[i] + tail.y);
        context.lineTo(x[i], y[i]);
      }
      context.stroke();
    }

    /** The glow for a Heat step, made the first time it's needed. */
    function glowFor(step: number, radius: number) {
      let glow = glows.get(step);
      if (!glow) {
        glow = makeGlow(heatTable[step], radius, scale);
        glows.set(step, glow);
      }
      return glow;
    }

    function frame(now: number) {
      if (!dots) return;
      const elapsed = now - lastFrame;
      lastFrame = now;
      const pusher = choosePusher({
        pointer,
        idleFor: now - pointerGoneAt,
        time: now,
        mark: letterBounds,
      });
      const areDotsStill = stepDots(dots, elapsed, pusher, pushRadius);
      // Both steps must run every frame, so neither can be skipped by &&.
      const areColorsResting = stepTrails(trails, dots, elapsed, afterglow);
      const isSettled = areDotsStill && areColorsResting;
      draw();

      const hasPointer = pointer !== null;
      if (canStopDrawing({ isSettled, hasPointer }) || !canDraw()) {
        frameRequest = 0;
        return;
      }
      frameRequest = requestAnimationFrame(frame);
    }

    function canDraw() {
      return isOnScreen && !document.hidden && !reducedMotion.matches;
    }

    function wake() {
      if (frameRequest || !dots || !canDraw()) return;
      lastFrame = performance.now();
      frameRequest = requestAnimationFrame(frame);
    }

    function follow(clientX: number, clientY: number) {
      const area = root.getBoundingClientRect();
      const point = { x: clientX - area.left, y: clientY - area.top };
      if (!isNearMark(point, letterBounds, pushRadius)) {
        release();
        return;
      }
      pointer = point;
      wake();
    }

    function release() {
      if (!pointer) return;
      pointer = null;
      pointerGoneAt = performance.now();
      wake();
    }

    // Touch is followed through touch events, which keep coming while the
    // page scrolls; pointer events stop as soon as a scroll starts.
    window.addEventListener('pointermove', (event) => {
      if (event.pointerType !== 'touch') follow(event.clientX, event.clientY);
    });
    for (const type of ['touchstart', 'touchmove'] as const) {
      window.addEventListener(
        type,
        (event) => {
          const touch = event.touches[0];
          if (touch) follow(touch.clientX, touch.clientY);
        },
        { passive: true },
      );
    }
    window.addEventListener('touchend', release);
    window.addEventListener('touchcancel', release);
    document.documentElement.addEventListener('pointerleave', release);
    window.addEventListener('blur', release);

    new IntersectionObserver(([entry]) => {
      isOnScreen = entry.isIntersecting;
      wake();
    }).observe(root);
    document.addEventListener('visibilitychange', wake);

    // Also runs once when it starts observing, which does the first build.
    new ResizeObserver(() => build()).observe(root);

    // Recolored straight away, so the theme reveal pictures the new
    // palette. The trails carry on, so moving dots swap palettes mid-move.
    new MutationObserver(() => {
      recolor();
      draw();
    }).observe(document.documentElement, { attributeFilter: ['data-theme'] });

    reducedMotion.addEventListener('change', () => {
      if (reducedMotion.matches) {
        cancelAnimationFrame(frameRequest);
        frameRequest = 0;
        delete root.dataset.drawn;
      } else {
        build();
      }
    });
  }

  const root = document.querySelector<HTMLElement>('[data-dot-mark]');
  const canvas = root?.querySelector('canvas');
  const still = root?.querySelector<HTMLElement>('[data-still]');
  const context = canvas?.getContext('2d');
  if (root && canvas && still && context) animate(root, canvas, still, context);
</script>
