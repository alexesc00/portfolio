---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

{/*
 * The padlock on a works table row that can't be opened, drawn in the
 * text color. Exported from the Figma component "Works table / Toggle".
 * Decorative: the row says it's locked in words beside it.
 */}
<svg
  viewBox="0 0 18 18"
  fill="none"
  stroke="currentColor"
  stroke-width="1.125"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
>
  <path d="M12.75 8.25H5.25C4.42157 8.25 3.75 8.92157 3.75 9.75V14.25C3.75 15.0784 4.42157 15.75 5.25 15.75H12.75C13.5784 15.75 14.25 15.0784 14.25 14.25V9.75C14.25 8.92157 13.5784 8.25 12.75 8.25Z" />
  <path d="M6 8.25V6C6 5.20435 6.31607 4.44129 6.87868 3.87868C7.44129 3.31607 8.20435 3 9 3C9.79565 3 10.5587 3.31607 11.1213 3.87868C11.6839 4.44129 12 5.20435 12 6V8.25" />
</svg>
