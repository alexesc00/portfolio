---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

{/*
 * The moon beside "dark", drawn in the text color, as in the Figma section
 * "Theme switch icon" on the Hero type page. Decorative: the button's
 * words say what it does.
 *
 * Figma exports its inside-aligned outline as a mask. This draws the same
 * line as a plain stroke along the moon shrunk by half the line's width
 * (both circles' radii 0.625 smaller), because Safari loses SVG masks
 * inside a 3D transform, and the hero's bottom line tips back in 3D.
 */}
<svg viewBox="0 0 14 14" fill="none" aria-hidden="true" class={className}>
  <path
    d="M5.214 2.464A4.875 4.875 0 1 0 11.536 8.786A4.875 4.875 0 0 1 5.214 2.464Z"
    stroke="currentColor"
    stroke-width="1.25"
  />
</svg>
