---
import type { ImageOutputFormat } from 'astro';
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { stepLabel } from '../lib/showcase-progress';

type Showcase = Extract<
  CollectionEntry<'projects'>['data'],
  { showcase: unknown }
>['showcase'];

interface Props {
  showcase: Showcase;
}

const { showcase } = Astro.props;
const looks = [
  { look: 'stock', stills: showcase.stock },
  { look: 'brand', stills: showcase.brand },
] as const;

// Each still is captured at twice the size the box draws it.
const formats: ImageOutputFormat[] = ['avif', 'webp'];
const stillSizes = {
  large: { widths: [872, 1744], sizes: '872px' },
  medium: { widths: [766, 1532], sizes: '(min-width: 1024px) 60vw, 100vw' },
  phone: { widths: [342, 684], sizes: '100vw' },
};
const still = 'size-full object-cover object-top-left';
// Out of the layout, so a still fills its layer rather than the <picture>
const wrapper = { class: 'contents' };

/*
 * The screen shows a light app in both of the site's themes, so what sits
 * on it keeps the dark mode's colors in light mode too: dark, with light
 * text.
 */
const onScreen =
  'bg-background text-text light:bg-foreground light:text-background';
const tag = [
  onScreen,
  'showcase-tag pointer-events-none absolute bottom-3.5 flex h-7 items-center rounded-full px-3 text-interface',
];
---

{/*
 * The live app's box: a device frame, the opened row's strip under it.
 * Stills of both looks show first, and the seam works on them straight
 * away. From 1024 wide up the app starts as the row opens and runs in
 * their place; if it can't start, the stills stay. Narrower, the stills
 * are all there is.
 */}
<div
  class="group/showcase"
  data-status="still"
  data-showcase
  data-app={showcase.app}
>
  <div class="rounded-2xl bg-surface p-2 ring-1 ring-border-strong ring-inset max-md:aspect-358/400 md:aspect-888/568">
    <div class="relative size-full overflow-hidden rounded-lg" data-screen>
      {/*
       * The compare view: both looks, the seam and the tags. While Python
       * starts it all sits out of focus, and only the percentage over it
       * moves; sharp means ready. It's scaled up a little meanwhile so the
       * blur's soft edges fall outside the screen.
       */}
      <div
        class="absolute inset-0 transition-[filter,scale] duration-settle ease-settle group-data-[status=starting]/showcase:scale-110 group-data-[status=starting]/showcase:blur-xl motion-reduce:transition-none"
        data-view
      >
        {looks.map(({ look, stills }) => (
          <div class="showcase-layer absolute inset-0" data-layer={look}>
            <Picture
              src={stills.phone}
              alt={stills.alt}
              {...stillSizes.phone}
              formats={formats}
              loading="lazy"
              pictureAttributes={wrapper}
              class:list={[still, 'md:hidden']}
            />
            <Picture
              src={stills.medium}
              alt={stills.alt}
              {...stillSizes.medium}
              formats={formats}
              loading="lazy"
              pictureAttributes={wrapper}
              class:list={[still, 'max-md:hidden 2xl:hidden']}
            />
            <Picture
              src={stills.large}
              alt={stills.alt}
              {...stillSizes.large}
              formats={formats}
              loading="lazy"
              pictureAttributes={wrapper}
              class:list={[still, 'hidden 2xl:block']}
            />
            {/* The live app, drawn at its own size and scaled to fit */}
            <div
              class="absolute top-0 left-0 origin-top-left opacity-0 transition-opacity duration-settle ease-settle data-shown:opacity-100 max-md:hidden motion-reduce:transition-none"
              data-live
            />
          </div>
        ))}
        <div
          role="slider"
          tabindex="0"
          aria-label="Seam between stock Streamlit and the MissionML look"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="33"
          aria-valuetext="A third stock Streamlit"
          class="showcase-seam absolute inset-y-0 left-(--seam) z-10 -ml-5 flex w-10 cursor-ew-resize touch-none justify-center"
          data-seam
        >
          <span
            class="h-full w-px bg-background light:bg-foreground"
            aria-hidden="true"
          ></span>
          <span
            class:list={[
              onScreen,
              'absolute top-1/2 flex size-9 -translate-y-1/2 items-center justify-center rounded-full',
            ]}
            aria-hidden="true"
            data-seam-handle
          >
            <svg
              viewBox="0 0 36 36"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-9"
            >
              <path d="M16 14L12 18L16 22M20 14L24 18L20 22" />
            </svg>
          </span>
        </div>
        <span class:list={[tag, 'left-3.5 z-10']} data-tag="stock">
          Stock Streamlit
        </span>
        <span class:list={[tag, 'right-3.5 z-10']} data-tag="brand">
          MissionML
        </span>
      </div>
      {/*
       * How far the live app has got starting up, over the blurred view:
       * the only sign that it's starting. Screen readers hear it from the
       * announcement below instead.
       */}
      <div
        class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center gap-2.5 text-text opacity-0 transition-opacity duration-settle ease-settle group-data-[status=starting]/showcase:opacity-100 max-md:hidden motion-reduce:transition-none light:text-background"
        aria-hidden="true"
      >
        <span class="absolute inset-0 bg-background opacity-60 light:bg-foreground"></span>
        <span class="relative text-title tabular-nums" data-progress-label>
          0%
        </span>
        <span class="relative h-1 w-40 overflow-hidden rounded-full bg-current/22">
          {/* Filled by scaling, not by width, so it never lays out again */}
          <span
            class="block h-full origin-left rounded-full bg-current transition-transform duration-settle ease-settle motion-reduce:transition-none"
            style="transform: scaleX(0)"
            data-progress-bar
          ></span>
        </span>
        <span class="relative text-interface opacity-60" data-progress-step>
          {stepLabel(0)}
        </span>
      </div>
    </div>
  </div>
  <span class="sr-only" aria-live="polite" data-announce></span>
</div>

<script>
  import {
    clampSeam,
    fitApp,
    seamAfterKey,
    shownTags,
    type ShowcaseStatus,
  } from '../lib/showcase-compare';
  import { mirror } from '../lib/showcase-mirror';
  import { parseProgressMessage, stepLabel } from '../lib/showcase-progress';

  type Look = 'stock' | 'brand';

  const wide = matchMedia('(min-width: 64rem)');
  // Two Pythons downloading on a slow connection can take this long
  const startTimeoutMs = 90_000;

  for (const root of document.querySelectorAll<HTMLElement>(
    '[data-showcase]',
  )) {
    setUp(root);
  }

  function setUp(root: HTMLElement) {
    const screen = root.querySelector<HTMLElement>('[data-screen]');
    const seam = root.querySelector<HTMLElement>('[data-seam]');
    const announce = root.querySelector<HTMLElement>('[data-announce]');
    const view = root.querySelector<HTMLElement>('[data-view]');
    const progressStep = root.querySelector<HTMLElement>(
      '[data-progress-step]',
    );
    const progressLabel = root.querySelector<HTMLElement>(
      '[data-progress-label]',
    );
    const progressBar = root.querySelector<HTMLElement>('[data-progress-bar]');
    const app = root.dataset.app;
    if (
      !screen ||
      !seam ||
      !announce ||
      !view ||
      !progressStep ||
      !progressLabel ||
      !progressBar ||
      !app
    ) {
      return;
    }
    const holders = {
      stock: screen.querySelector<HTMLElement>(
        '[data-layer=stock] [data-live]',
      ),
      brand: screen.querySelector<HTMLElement>(
        '[data-layer=brand] [data-live]',
      ),
    };
    const tags = {
      stock: screen.querySelector<HTMLElement>('[data-tag=stock]'),
      brand: screen.querySelector<HTMLElement>('[data-tag=brand]'),
    };
    const handle = seam.querySelector<HTMLElement>('[data-seam-handle]');

    // The seam
    // Where the seam starts depends on the screen's width; see the styles
    let seamAt = parseFloat(getComputedStyle(root).getPropertyValue('--seam'));
    /*
     * Where the tags sit, measured when the screen changes size rather
     * than on every move of the seam, so dragging never makes the browser
     * lay the page out again.
     */
    let tagBounds = { stockRight: 0, brandLeft: 0, reach: 0 };
    function measureTags() {
      if (!tags.stock || !tags.brand || !handle) return;
      tagBounds = {
        stockRight: tags.stock.offsetLeft + tags.stock.offsetWidth,
        brandLeft: tags.brand.offsetLeft,
        reach: handle.offsetWidth,
      };
    }
    function showTags() {
      // Not measured yet, or the screen isn't showing
      if (!tagBounds.reach) return;
      const shown = shownTags(
        (seamAt / 100) * (screen?.clientWidth ?? 0),
        tagBounds,
        tagBounds.reach,
      );
      tags.stock?.style.setProperty('--shown', String(shown.stock));
      tags.brand?.style.setProperty('--shown', String(shown.brand));
    }
    function setSeam(percent: number) {
      seamAt = clampSeam(percent);
      root.style.setProperty('--seam', `${seamAt}%`);
      showTags();
      seam?.setAttribute('aria-valuenow', String(Math.round(seamAt)));
      seam?.setAttribute(
        'aria-valuetext',
        `${Math.round(seamAt)}% stock Streamlit`,
      );
    }
    setSeam(seamAt);
    const percentAt = (event: PointerEvent) => {
      const box = screen.getBoundingClientRect();
      return ((event.clientX - box.left) / box.width) * 100;
    };
    seam.addEventListener('pointerdown', (event) => {
      seam.setPointerCapture(event.pointerId);
      root.toggleAttribute('data-dragging', true);
      const move = (moveEvent: PointerEvent) => setSeam(percentAt(moveEvent));
      seam.addEventListener('pointermove', move);
      seam.addEventListener(
        'lostpointercapture',
        () => {
          seam.removeEventListener('pointermove', move);
          root.removeAttribute('data-dragging');
        },
        { once: true },
      );
    });
    seam.addEventListener('keydown', (event) => {
      const next = seamAfterKey(seamAt, event.key, event.shiftKey);
      if (next === null) return;
      event.preventDefault();
      setSeam(next);
    });

    // The live app: two copies, one in each look, kept in step
    let status: ShowcaseStatus = 'still';
    let frames: Record<Look, HTMLIFrameElement> | null = null;
    let stopWaiting = () => {};

    function showStatus(next: ShowcaseStatus, announcement: string) {
      status = next;
      root.dataset.status = next;
      if (announce) announce.textContent = announcement;
      // Out of focus while starting, so nothing in it can be reached yet
      if (view) view.inert = next === 'starting';
    }

    function showProgress(percent: number) {
      if (!progressLabel || !progressBar || !progressStep) return;
      progressLabel.textContent = `${Math.round(percent)}%`;
      progressStep.textContent = stepLabel(percent);
      progressBar.style.transform = `scaleX(${percent / 100})`;
    }

    function fit() {
      const size = fitApp(screen?.clientWidth ?? 0, screen?.clientHeight ?? 0);
      for (const holder of Object.values(holders)) {
        if (!holder) continue;
        holder.style.width = `${size.width}px`;
        holder.style.height = `${size.height}px`;
        holder.style.transform = `scale(${size.scale})`;
      }
      measureTags();
      showTags();
    }
    new ResizeObserver(fit).observe(screen);

    function frameFor(look: Look) {
      const url = new URL(app ?? '', location.href);
      if (look === 'stock') url.searchParams.set('look', 'stock');
      const frame = document.createElement('iframe');
      frame.src = url.href;
      frame.className = 'block size-full border-0';
      if (look === 'brand') {
        frame.title = 'The MissionML design system, running live';
      } else {
        // The same app without the brand. The brand copy is the one to
        // tab into; this one follows along.
        frame.title = 'The same app in stock Streamlit';
        frame.tabIndex = -1;
        frame.setAttribute('aria-hidden', 'true');
      }
      return frame;
    }

    function stop() {
      stopWaiting();
      for (const frame of Object.values(frames ?? {})) frame.remove();
      frames = null;
      for (const holder of Object.values(holders)) {
        holder?.removeAttribute('data-shown');
      }
    }

    function start() {
      if (status === 'starting' || status === 'live') return;
      stop();
      showStatus('starting', 'Starting the live app');
      const started = { stock: frameFor('stock'), brand: frameFor('brand') };
      frames = started;
      const waiting = new Set<Look>(['stock', 'brand']);
      // Each copy's progress; the slower one is the one shown
      const reached = { stock: 0, brand: 0 };
      showProgress(0);

      const onMessage = (event: MessageEvent) => {
        if (event.origin !== location.origin) return;
        const look = (['stock', 'brand'] as const).find(
          (candidate) => event.source === started[candidate].contentWindow,
        );
        if (!look) return;
        const percent = parseProgressMessage(event.data);
        if (percent !== null) {
          reached[look] = Math.max(reached[look], percent);
          showProgress(Math.min(reached.stock, reached.brand));
          return;
        }
        const { showcase } = (event.data ?? {}) as { showcase?: unknown };
        if (showcase === 'failed') fail();
        if (showcase !== 'ready') return;
        waiting.delete(look);
        if (waiting.size === 0) becomeLive(started);
      };
      const timeout = window.setTimeout(fail, startTimeoutMs);
      stopWaiting = () => {
        window.removeEventListener('message', onMessage);
        clearTimeout(timeout);
      };
      window.addEventListener('message', onMessage);

      fit();
      holders.stock?.append(started.stock);
      holders.brand?.append(started.brand);
    }

    function becomeLive(started: Record<Look, HTMLIFrameElement>) {
      stopWaiting();
      const stockPage = started.stock.contentDocument;
      const brandPage = started.brand.contentDocument;
      if (!stockPage || !brandPage) {
        fail();
        return;
      }
      mirror(stockPage, brandPage);
      mirror(brandPage, stockPage);
      showProgress(100);
      for (const holder of Object.values(holders)) {
        holder?.setAttribute('data-shown', '');
      }
      showStatus('live', 'The live app is running');
    }

    // The stills are the same screen, so a failed start just leaves them
    function fail() {
      stop();
      showStatus('still', 'The live app couldn’t start; the stills stay');
    }

    const row = root.closest('tr');

    // From 1024 wide up, the app starts once its row has finished opening:
    // starting two Pythons mid-slide would stall the slide, and a visitor
    // flicking the row open and shut would start one each time. A row
    // turned round mid-slide gets new slides, so this waits for those.
    function startOnceOpen() {
      if (!row || row.hidden || !wide.matches) return;
      const slides = row.getAnimations();
      if (slides.length === 0) {
        start();
        return;
      }
      Promise.all(slides.map((slide) => slide.finished)).then(
        startOnceOpen,
        startOnceOpen,
      );
    }

    // A row left closed stops the app: two Python runtimes running out of
    // sight cost the visitor CPU and memory, so reopening starts them
    // afresh. Reopening within a few seconds keeps the one running.
    const stopDelayMs = 5_000;
    let stopTimer = 0;
    if (row) {
      new MutationObserver(() => {
        clearTimeout(stopTimer);
        if (!row.hidden) {
          startOnceOpen();
        } else if (status !== 'still') {
          stopTimer = window.setTimeout(() => {
            stop();
            showStatus('still', '');
          }, stopDelayMs);
        }
      }).observe(row, { attributes: true, attributeFilter: ['hidden'] });
    }

    // A row that's open as the page loads starts its app only once it's
    // on screen, so a visitor who never scrolls to it doesn't download it
    if (row && !row.hidden) {
      const onScreen = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        onScreen.disconnect();
        if (!row.hidden && wide.matches) start();
      });
      onScreen.observe(root);
    }
  }
</script>

<style>
  /*
   * Where the seam starts: a third of the way across, or halfway on
   * phones, where a third falls on the "Stock Streamlit" tag and would
   * hide it.
   */
  [data-showcase] {
    --seam: 33.3333%;
  }

  @media (width < 48rem) {
    [data-showcase] {
      --seam: 50%;
    }
  }

  /* The brand copy covers the stock one to the right of the seam */
  [data-showcase] [data-layer='brand'] {
    clip-path: inset(0 0 0 var(--seam));
  }

  /*
   * As the seam nears a tag, the tag fades and slides 8px toward its own
   * edge, out of the seam's way, by how much of it still shows (--shown,
   * set by the script). Dragging, it follows the visitor's hand exactly;
   * when the seam jumps (arrow keys, Home and End, the screen resizing)
   * it settles there instead of snapping.
   */
  .showcase-tag {
    --away: -1;
    opacity: var(--shown, 1);
    translate: calc((1 - var(--shown, 1)) * var(--away) * var(--spacing) * 2) 0;
    transition:
      opacity var(--transition-duration-settle) var(--ease-settle),
      translate var(--transition-duration-settle) var(--ease-settle);
  }

  [data-tag='brand'] {
    --away: 1;
  }

  [data-dragging] .showcase-tag {
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .showcase-tag {
      transition: none;
    }
  }
</style>
