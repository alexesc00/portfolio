---
import MoonIcon from './MoonIcon.astro';
import SunIcon from './SunIcon.astro';

/*
 * As tall as the text, 1em, and a space's width before the word. The
 * capitals are 0.65em tall, so dropping the icon (1 − 0.65) / 2 = 0.175em
 * below the baseline centres it on them.
 */
const iconClass = 'mr-1 inline-block size-[1em] align-[-0.175em]';
---

{/* The accessible name starts with the visible word, so voice control users can say what they see. */}
<button type="button" class="cursor-pointer text-text" data-theme-switch>
  <span class="light:hidden">
    <MoonIcon class={iconClass} />
    <span class="underline decoration-dotted">dark</span>
    <span class="sr-only">, switch to light mode</span>
  </span>
  <span class="hidden light:inline">
    <SunIcon class={iconClass} />
    <span class="underline decoration-dotted">light</span>
    <span class="sr-only">, switch to dark mode</span>
  </span>
</button>

<script>
  import {
    oppositeTheme,
    parseTheme,
    readSavedTheme,
    revealRadius,
    saveTheme,
    systemTheme,
    themeColors,
    type Theme,
  } from '../lib/theme';

  const root = document.documentElement;
  const systemPrefersLight = matchMedia('(prefers-color-scheme: light)');
  const prefersReducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

  /** Switches the page to `theme`, browser bar included. */
  function showTheme(theme: Theme) {
    root.dataset.theme = theme;
    // Both tags, since the browser picks one by the system setting.
    for (const meta of document.querySelectorAll<HTMLMetaElement>(
      'meta[name="theme-color"]',
    )) {
      meta.content = themeColors[theme];
    }
  }

  /** Grows the new theme as a circle from `origin` over the old one. */
  function revealTheme(theme: Theme, origin: Element) {
    if (!('startViewTransition' in document) || prefersReducedMotion.matches) {
      showTheme(theme);
      return;
    }

    const { left, top, width, height } = origin.getBoundingClientRect();
    const x = left + width / 2;
    const y = top + height / 2;
    const radius = revealRadius(
      { x, y },
      { width: innerWidth, height: innerHeight },
    );
    root.style.setProperty('--reveal-x', `${x}px`);
    root.style.setProperty('--reveal-y', `${y}px`);
    root.style.setProperty('--reveal-radius', `${radius}px`);
    root.dataset.themeReveal = '';

    const transition = document.startViewTransition(() => showTheme(theme));
    // The browser skips the animation when the tab isn't being drawn. The
    // theme still changes, so there's nothing to handle.
    transition.ready.catch(() => {});
    transition.finished.finally(() => {
      delete root.dataset.themeReveal;
      root.style.removeProperty('--reveal-x');
      root.style.removeProperty('--reveal-y');
      root.style.removeProperty('--reveal-radius');
    });
  }

  const button = document.querySelector('[data-theme-switch]');
  button?.addEventListener('click', () => {
    const next = oppositeTheme(parseTheme(root.dataset.theme) ?? 'dark');
    saveTheme(() => localStorage, next);
    revealTheme(next, button);
  });

  // Until the visitor chooses, keep following the system setting live.
  systemPrefersLight.addEventListener('change', (event) => {
    if (!readSavedTheme(() => localStorage)) {
      showTheme(systemTheme(event.matches));
    }
  });
</script>

{/* Global because the reveal covers the whole page, not just the button. */}
<style is:global>
  /*
   * The browser takes a picture of the page, switches the theme, then
   * uncovers the new page over the picture. The old picture holds still.
   * Clipping a picture never makes the browser lay the page out again,
   * which is what makes most animations expensive.
   */
  :root[data-theme-reveal]::view-transition-old(root) {
    animation: none;
  }

  :root[data-theme-reveal]::view-transition-new(root) {
    animation: theme-reveal var(--transition-duration-reveal) var(--ease-in-out);
  }

  @keyframes theme-reveal {
    from {
      clip-path: circle(0 at var(--reveal-x) var(--reveal-y));
    }
    to {
      clip-path: circle(
        var(--reveal-radius) at var(--reveal-x) var(--reveal-y)
      );
    }
  }
</style>
