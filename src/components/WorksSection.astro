---
import type { CollectionEntry } from 'astro:content';
import WorksTable from './WorksTable.astro';

interface Props {
  projects: CollectionEntry<'projects'>['data'][];
}

const { projects } = Astro.props;
---

<section
  id="work"
  aria-labelledby="work-heading"
  class="mx-auto w-full max-w-(--breakpoint-2xl) px-page pt-8 pb-inset md:pt-7"
>
  {/*
   * From 1024 up the heading is a running head at the top right;
   * narrower, it sits at the left to caption the table.
   */}
  <h2
    id="work-heading"
    class="text-interface md:text-title lg:mb-30 lg:text-right"
  >
    Selected work
  </h2>
  <WorksTable projects={projects} />
</section>
