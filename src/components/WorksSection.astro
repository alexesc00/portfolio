---
import type { CollectionEntry } from 'astro:content';
import WorksTable from './WorksTable.astro';

interface Props {
  projects: CollectionEntry<'projects'>['data'][];
}

const { projects } = Astro.props;
---

<section
  id="work"
  aria-labelledby="work-heading"
  class="mx-auto w-full max-w-(--breakpoint-2xl) px-page pt-inset pb-inset"
>
  {/* Like every section, it opens on its name at the top left. */}
  <h2 id="work-heading" class="mb-12 text-display md:mb-16">
    Selected work
  </h2>
  <WorksTable projects={projects} />
</section>
