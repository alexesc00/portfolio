---
import type { CollectionEntry } from 'astro:content';
import EyeIcon from './EyeIcon.astro';
import { worksGrid } from '../lib/works-grid';
import LockIcon from './LockIcon.astro';
import WorksTableOpenedRow from './WorksTableOpenedRow.astro';
import WorksTableToggle from './WorksTableToggle.astro';

interface Props {
  projects: CollectionEntry<'projects'>['data'][];
}

const { projects } = Astro.props;
const rows = projects.toSorted((a, b) => a.order - b.order);

/** The id of the row that opens under the project's own row. */
const openedRowId = (name: string) =>
  `works-${name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;

/*
 * A column the screen is too narrow for is hidden from sight but still
 * read out by screen readers. On phones, What I did drops onto a second
 * line under Solution.
 */
const column = {
  details: 'col-span-1 lg:col-span-4 xl:col-span-1',
  category: 'sr-only xl:not-sr-only xl:col-span-3',
  solution: 'col-span-5 pr-6 md:col-span-2 md:pr-0 lg:col-span-4',
  whatIDid:
    'col-span-5 col-start-2 pr-6 md:col-span-3 md:col-start-auto lg:col-span-4 2xl:col-span-3 2xl:pr-0',
  segment: 'sr-only 2xl:not-sr-only 2xl:col-span-1 2xl:text-right',
};
// Header cells are bold and centered by default; this sets them like the rows.
const header = 'text-left text-interface';
---

<table class="block w-full">
  <thead class="block">
    <tr
      class:list={[
        worksGrid,
        'border-b border-border pt-6 pb-4.75 text-text-muted',
      ]}
    >
      <th scope="col" class:list={[header, column.details, 'pl-3.75']}>
        <EyeIcon class="size-4.5" />
        <span class="sr-only">Details</span>
      </th>
      <th scope="col" class:list={[header, column.category]}>
        Category
      </th>
      <th scope="col" class:list={[header, column.solution]}>
        Solution
      </th>
      <th scope="col" class:list={[header, column.whatIDid, 'max-md:sr-only']}>
        What I did
      </th>
      <th scope="col" class:list={[header, column.segment]}>
        Segment
      </th>
    </tr>
  </thead>
  {/* One group per project: its row, then the row it opens. */}
  {rows.map((project) => (
    <tbody class="block">
      <tr
        class:list={[
          worksGrid,
          'relative border-b border-border pt-2 pb-1.75',
          // An open row hands its bottom line to the row it opens.
          !project.locked &&
            'group/row has-aria-expanded:border-b-0 has-aria-expanded:pb-2',
        ]}
      >
        <td class={column.details}>
          {project.locked ? (
            <div class="flex size-12 items-center justify-center rounded-xl bg-surface">
              <LockIcon class="size-4.5" />
              <span class="sr-only">Locked, under NDA</span>
            </div>
          ) : (
            <WorksTableToggle
              projectName={project.name}
              controls={openedRowId(project.name)}
            />
          )}
        </td>
        {/* Pointing at the row shows the project's name over its Category. */}
        <td class:list={[column.category, 'py-3.5']}>
          {/*
           * The name is placed against this wrapper, not the cell: the
           * class that shows the cell from 1280 up also resets its position.
           */}
          <span class="relative block">
            <span class="group-hover/row:opacity-0 group-has-focus-visible/row:opacity-0">
              {project.category}
            </span>
            {!project.locked && (
              <span
                aria-hidden="true"
                class="absolute inset-0 opacity-0 group-hover/row:opacity-100 group-has-focus-visible/row:opacity-100"
              >
                {project.name}
              </span>
            )}
          </span>
        </td>
        <td class:list={[column.solution, 'py-3.5 max-md:pb-0']}>
          {project.solution}
        </td>
        <td class:list={[column.whatIDid, 'py-3.5 max-md:pt-2']}>
          {project.practices.join(', ')}
        </td>
        <td class:list={[column.segment, 'py-3.5']}>{project.segment}</td>
      </tr>
      {!project.locked && (
        <WorksTableOpenedRow project={project} id={openedRowId(project.name)} />
      )}
    </tbody>
  ))}
</table>
