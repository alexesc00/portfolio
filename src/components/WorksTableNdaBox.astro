---
import LockIcon from './LockIcon.astro';
---

{/*
 * Stands in for a project's images when the work is under NDA: an empty
 * box the size of the image box, so the row looks like every other row
 * with its images held back. The dotted edge is the one line drawn inside
 * an opened row, kept faint so the box reads as a gap left on purpose.
 * The aspect ratios match the wide images (1776 × 1240); phones get a
 * shorter box, since there's nothing in it to show.
 */}
<div
  role="img"
  aria-label="Images withheld under NDA"
  class="relative flex aspect-358/224 w-full items-center justify-center gap-2 text-interface text-text-muted md:aspect-1776/1240"
  data-nda-box
>
  <svg class="nda-edge absolute inset-0 size-full" aria-hidden="true">
    <rect />
  </svg>
  <LockIcon class="size-4.5" />
  <span>NDA</span>
</div>

<style>
  /*
   * A CSS dotted border sets its dots edge to edge, which reads as a solid
   * line at 1px. Drawn as an outline instead, the dots are round and a
   * little apart. The rect is inset by half its stroke so none of it is
   * clipped, and its corners match rounded-2xl.
   */
  .nda-edge rect {
    x: 0.625px;
    y: 0.625px;
    width: calc(100% - 1.25px);
    height: calc(100% - 1.25px);
    rx: var(--radius-2xl);
    fill: none;
    stroke: var(--color-border-strong);
    stroke-width: 1.25px;
    stroke-linecap: round;
    stroke-dasharray: 0 3.5px;
  }
</style>
