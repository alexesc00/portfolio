---
import type { ImageOutputFormat } from 'astro';
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { worksGrid } from '../lib/works-grid';
import ShowcaseCompare from './ShowcaseCompare.astro';
import WorksTableNdaBox from './WorksTableNdaBox.astro';
import WorksTableStrip from './WorksTableStrip.astro';

type OpenProject = Extract<
  CollectionEntry<'projects'>['data'],
  { locked: false }
>;

interface Props {
  project: OpenProject;
  /** The id the row's button points at. */
  id: string;
}

const { project, id } = Astro.props;

const chapters = [
  { label: 'Problem', text: project.writeUp.problem },
  { label: 'Approach', text: project.writeUp.approach },
  ...(project.writeUp.outcome
    ? [{ label: 'Outcome', text: project.writeUp.outcome }]
    : []),
];

// Each image is exported at twice the size Figma draws it. `sizes` is
// the box's real width at each breakpoint, measured in the browser, so
// the browser picks the smallest file that still fills it at the
// screen's density rather than one a size up.
const formats: ImageOutputFormat[] = ['avif', 'webp'];
const wideImage = {
  widths: [672, 888, 1344, 1776],
  sizes:
    '(min-width: 1440px) 888px, (min-width: 1280px) calc(66.67vw - 72px), (min-width: 768px) calc(100vw - 96px), calc(100vw - 32px)',
  formats,
  loading: 'lazy' as const,
};
const phoneImage = {
  widths: [358, 716],
  sizes: 'calc(100vw - 32px)',
  formats,
  loading: 'lazy' as const,
};
---

{/*
 * The write-up sits beside the image from 1280 wide up and above it on
 * narrower screens, where it stays 440px wide, the measure Figma sets
 * for it, rather than widening with the grid. Its type is the same at
 * every width. It tells the project in chapters, each under its label.
 * The row ends with an ask for the full case study, which goes to the
 * contact section until there are case studies on the site. It comes
 * after the image, so on narrower screens it's the last thing in the
 * row; beside the image it moves up under the write-up, level with the
 * strip under the image. Every image comes in a wide and a phone version,
 * each in dark and light; only the one that fits the screen and theme
 * shows, and the hidden ones never load. A project with a live showcase
 * shows that instead, and one under NDA shows an empty box saying so.
 * Either way the strip follows: Live, if the project
 * shipped, and the tools it was built with. It has no line of its own:
 * the line under it belongs to the group below, which slides over it to
 * close it. Its top padding is Figma's 40px plus the 1px the row's own
 * line used to take.
 */}
<tr
  id={id}
  hidden={!project.isOpenByDefault}
  class="block pt-10.25 pb-5.75 data-sliding:pointer-events-none data-sliding:overflow-hidden"
  data-opened-row
>
  <td colspan="5" class:list={[worksGrid, 'pointer-events-auto gap-y-10']}>
    <div class="col-span-6 max-w-110 lg:col-span-12 xl:col-span-4 xl:row-start-1 xl:max-w-none xl:pr-6">
      <h3 class="text-title">{project.name}</h3>
      <div class="mt-8 flex flex-col gap-6">
        {chapters.map(({ label, text }, i) => (
          <div>
            <h4 class="text-interface">{label}</h4>
            <p class="mt-2 text-reading text-text-muted">{text}</p>
            {project.link && i === chapters.length - 1 && (
              <a
                href={project.link.url}
                class="mt-2 inline-block text-interface"
              >
                {project.link.text} <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        ))}
      </div>
    </div>
    <div class="col-span-6 flex flex-col gap-3 lg:col-span-12 xl:col-span-8 xl:col-start-5 xl:row-span-2 xl:row-start-1">
      <div>
        {'showcase' in project ? (
          <ShowcaseCompare showcase={project.showcase} />
        ) : 'isUnderNda' in project ? (
          <WorksTableNdaBox />
        ) : (
          <>
            <Picture
              src={project.images.wide.dark}
              alt={project.images.wide.alt}
              {...wideImage}
              class="h-auto w-full max-md:hidden light:hidden"
            />
            <Picture
              src={project.images.wide.light}
              alt={project.images.wide.alt}
              {...wideImage}
              class="hidden h-auto w-full md:light:block"
            />
            <Picture
              src={project.images.phone.dark}
              alt={project.images.phone.alt}
              {...phoneImage}
              class="h-auto w-full md:hidden light:hidden"
            />
            <Picture
              src={project.images.phone.light}
              alt={project.images.phone.alt}
              {...phoneImage}
              class="hidden h-auto w-full max-md:light:block"
            />
          </>
        )}
      </div>
      <WorksTableStrip isLive={project.isLive} tools={project.tools} />
    </div>
    <a
      href="#contact"
      class="group col-span-6 h-10 self-start justify-self-start text-interface leading-10 lg:col-span-12 xl:col-span-4 xl:col-start-1 xl:row-start-2 xl:self-end"
    >
      <span class="group-hover:underline">Ask for the full case study</span>{' '}
      <span aria-hidden="true">↓</span>
    </a>
  </td>
</tr>

<script>
  import { imagesThatWillShow } from '../lib/row-images';

  /*
   * A shut row's images are lazy, so nothing would load until the click,
   * and the visitor would wait for the download and the decode. Instead
   * each row's image starts loading as soon as the visitor points at or
   * tabs to the row, and every row's loads quietly, one at a time, once
   * the page is idle. Only the version that fits the screen and theme
   * loads; the others stay lazy.
   */
  const isHidden = (element: Element) =>
    getComputedStyle(element).display === 'none';

  /** Starts loading what `row` will show, and settles once it has. */
  function warm(row: HTMLElement, priority: 'high' | 'low') {
    const images = imagesThatWillShow<Element, HTMLImageElement>(row, isHidden);
    return Promise.all(
      images.map((image) => {
        image.fetchPriority = priority;
        image.loading = 'eager';
        return image.complete
          ? undefined
          : new Promise((resolve) => {
              image.addEventListener('load', resolve, { once: true });
              image.addEventListener('error', resolve, { once: true });
            });
      }),
    );
  }

  const rows = [...document.querySelectorAll<HTMLElement>('[data-opened-row]')];

  for (const row of rows) {
    const button = document.querySelector(`[aria-controls="${row.id}"]`);
    const warmNow = () => void warm(row, 'high');
    button?.addEventListener('pointerenter', warmNow, { once: true });
    button?.addEventListener('focus', warmNow, { once: true });
  }

  // Visitors who asked their browser to save data only load what they open.
  const savesData =
    'connection' in navigator &&
    (navigator.connection as { saveData?: boolean }).saveData === true;

  async function warmAll() {
    for (const row of rows) await warm(row, 'low');
  }

  function whenIdle(task: () => void) {
    if ('requestIdleCallback' in window) requestIdleCallback(task);
    else setTimeout(task, 1000);
  }

  if (!savesData) {
    if (document.readyState === 'complete') whenIdle(warmAll);
    else addEventListener('load', () => whenIdle(warmAll), { once: true });
  }
</script>
