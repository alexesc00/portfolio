---
import { toggleWord } from '../lib/row-toggle';
import ArrowIcon from './ArrowIcon.astro';

interface Props {
  projectName: string;
  /** The id of the row this button opens. */
  controls: string;
  isOpen?: boolean;
}

const { projectName, controls, isOpen = false } = Astro.props;
---

{/*
 * At rest it's a square with an arrow: up on a closed row, down on an
 * open one. When the row is pointed at or the button has keyboard focus,
 * it widens to say "Open" or "Close" and the arrow points the way the
 * row will go. Its ::after covers the whole row, so the row can be
 * clicked anywhere and pointing at the row is pointing at the button.
 * The ::after sits above the row's text: text that's positioned, moved,
 * masked or faded would otherwise be painted over it and take the pointer.
 */}
<button
  type="button"
  aria-expanded={isOpen ? 'true' : 'false'}
  aria-controls={controls}
  class="group/toggle flex h-12 cursor-pointer items-center gap-2.5 rounded-xl bg-surface px-3.75 after:absolute after:inset-0 after:z-10 hover:pr-4 focus-visible:pr-4"
  data-row-toggle
>
  <ArrowIcon class="size-4.5 shrink-0 transition-transform duration-settle ease-settle group-hover/toggle:rotate-180 group-focus-visible/toggle:rotate-180 group-aria-expanded/toggle:rotate-180 group-aria-expanded/toggle:group-hover/toggle:rotate-0 group-aria-expanded/toggle:group-focus-visible/toggle:rotate-0 motion-reduce:transition-none" />
  <span
    class="sr-only group-hover/toggle:not-sr-only group-focus-visible/toggle:not-sr-only"
    data-toggle-word
  >
    {isOpen ? toggleWord.open : toggleWord.closed}
  </span>
  <span class="sr-only">{` ${projectName}`}</span>
</button>

<script>
  import { millisecondsOf } from '../lib/css-duration';
  import {
    coverOffset,
    opennessAt,
    planDrawer,
    type DrawerSlide,
  } from '../lib/row-drawer';
  import { toggleRow } from '../lib/row-toggle';

  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const tokens = getComputedStyle(document.documentElement);
  const settle = {
    duration: millisecondsOf(
      tokens.getPropertyValue('--transition-duration-settle'),
    ),
    easing: tokens.getPropertyValue('--ease-settle').trim(),
  };

  /** Each drawer still moving: its slide, and the animations running it. */
  const moving = new Map<
    HTMLElement,
    { slide: DrawerSlide; animations: Animation[] }
  >();

  /** How open a moving drawer has got to, or null for one at rest. */
  function currentOpenness(panel: HTMLElement) {
    const drawer = moving.get(panel);
    if (!drawer) return null;
    const progress = drawer.animations[0]?.effect?.getComputedTiming().progress;
    return opennessAt(drawer.slide, progress ?? 1);
  }

  /**
   * Everything on the page after `group`: the groups under it in the
   * table, then everything after the table, all the way down.
   */
  function everythingAfter(group: Element) {
    const after: Element[] = [];
    for (
      let element: Element | null = group;
      element && element !== document.body;
      element = element.parentElement
    ) {
      for (
        let sibling = element.nextElementSibling;
        sibling;
        sibling = sibling.nextElementSibling
      ) {
        if (!['SCRIPT', 'STYLE', 'TEMPLATE'].includes(sibling.tagName)) {
          after.push(sibling);
        }
      }
    }
    return after;
  }

  /**
   * Opens or closes the drawer holding `panel`, the write-up under the
   * row in `group`. Everything under it slides down to uncover it, or up
   * over it: the groups under it and the rest of the page, so the page
   * below the table moves with them rather than jumping. The write-up is
   * cut off at the top edge of what's sliding, since the groups under it
   * can add up to less than its height and the rest of the page has no
   * background to cover it with. That holds for the last group too: the
   * page below slides over its write-up as the groups would. A drawer
   * still moving turns round from where it is.
   *
   * The cut is made with movement alone, like the slide: the write-up's
   * row hides what overflows it and slides with everything under it,
   * while what's inside slides back the other way and so stays put.
   * Browsers can run movement off the main thread, Safari among them, so
   * a cut made any other way would lag the slide there. Nothing else
   * changes either, so the page isn't laid out again every frame.
   */
  function slideDrawer(panel: HTMLElement, group: Element, isOpening: boolean) {
    const openness = currentOpenness(panel);
    moving.get(panel)?.animations.forEach((animation) => animation.cancel());
    moving.delete(panel);
    // A closing write-up stays in view until it's covered, but out of
    // reach of the keyboard and screen readers straight away.
    panel.inert = !isOpening;
    if (isOpening) panel.hidden = false;
    if (reducedMotion.matches) {
      panel.hidden = !isOpening;
      return;
    }

    const slide = planDrawer({ isOpening, openness });
    const after = everythingAfter(group);
    const contents = panel.firstElementChild;
    const height = panel.getBoundingClientRect().height;
    const timing = { ...settle, fill: 'forwards' as const };
    const offsets = (sign: number) => [
      { translate: `0 ${sign * coverOffset(slide.from, height)}px` },
      { translate: `0 ${sign * coverOffset(slide.to, height)}px` },
    ];
    // Several drawers can move at once, so each adds its own slide to
    // everything under it, its own write-up's row included.
    const animations = [
      ...[...after, panel].map((element) =>
        element.animate(offsets(1), { ...timing, composite: 'add' }),
      ),
      ...(contents ? [contents.animate(offsets(-1), timing)] : []),
    ];
    panel.toggleAttribute('data-sliding', true);
    const drawer = { slide, animations };
    moving.set(panel, drawer);

    animations[0]?.finished.then(
      () => {
        if (moving.get(panel) !== drawer) return;
        // Hidden in the same frame everything under it drops its slide, so
        // nothing jumps: the page closes up exactly where it had slid to.
        if (!isOpening) panel.hidden = true;
        panel.toggleAttribute('data-sliding', false);
        for (const animation of animations) animation.cancel();
        moving.delete(panel);
      },
      // Cancelled by a click that turned the drawer round.
      () => {},
    );
  }

  for (const button of document.querySelectorAll('[data-row-toggle]')) {
    const panel = document.getElementById(
      button.getAttribute('aria-controls') ?? '',
    );
    const word = button.querySelector('[data-toggle-word]');
    const group = button.closest('tbody');
    if (!panel || !word || !group) continue;
    button.addEventListener('click', () => {
      slideDrawer(panel, group, toggleRow({ button, word }));
    });
  }
</script>

<style>
  /*
   * The word slides and fades in on the settle curve as it appears
   * beside the arrow, so it arrives without a bounce, like the arrow.
   */
  @media (prefers-reduced-motion: no-preference) {
    @media (hover: hover) {
      button:hover [data-toggle-word] {
        animation:
          toggle-word-slide var(--transition-duration-settle) var(--ease-settle)
            both,
          toggle-word-fade var(--transition-duration-settle) var(--ease-settle)
            both;
      }
    }

    button:focus-visible [data-toggle-word] {
      animation:
        toggle-word-slide var(--transition-duration-settle) var(--ease-settle)
          both,
        toggle-word-fade var(--transition-duration-settle) var(--ease-settle)
          both;
    }
  }

  @keyframes toggle-word-slide {
    from {
      translate: calc(var(--spacing) * -2) 0;
    }
  }

  @keyframes toggle-word-fade {
    from {
      opacity: 0;
    }
  }
</style>
