---
import { getCollection } from 'astro:content';
import ContactSection from '../components/ContactSection.astro';
import Hero from '../components/Hero.astro';
import WorksSection from '../components/WorksSection.astro';
import PrinciplesSection from '../components/PrinciplesSection.astro';
import StatementSection from '../components/StatementSection.astro';
import Layout from '../layouts/Layout.astro';

const projects = (await getCollection('projects')).map(({ data }) => data);
---

<Layout
  title="Alex Escudero"
  description="Alex Escudero is a product designer. This site was designed in Figma and built in the open on GitHub."
>
  <Hero />
  <main>
    <StatementSection />
    <WorksSection projects={projects} />
    <PrinciplesSection />
    <ContactSection />
  </main>
</Layout>
